---
import Base from '../layouts/Base.astro';
import WovenDivider from '../components/WovenDivider.astro';
 
const waNumber = '628113822774'; // format 62xxxxxxxxxx, tanpa +, spasi, atau tanda hubung
 
const kontakCepat = [
  { label: 'WhatsApp', value: '+62 811-3822-774', href: `https://wa.me/${waNumber}` },
  { label: 'Telepon', value: '+62 811-3822-774', href: `tel:+${waNumber}` },
  { label: 'Facebook', value: 'Yeremia Priyanto', href: 'https://www.facebook.com/pelitakasih' },
  { label: 'Instagram', value: '@youth_goc_', href: 'https://instagram.com/youth_goc_' },
];
---
<Base title="Kontak" description="Hubungi Gereja Pelita Kasih untuk pertanyaan, permohonan doa, atau kunjungan.">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Kontak</p>
      <h1>Hubungi kami</h1>
      <p class="page-header__lead">
        Ada pertanyaan, ingin berkunjung, atau butuh didoakan? Tim kami senang
        mendengar dari kamu.
      </p>
    </div>
  </section>
 
  <WovenDivider />
 
  <section class="section">
    <div class="container kontak-grid">
      <div class="kontak-cepat">
        <p class="eyebrow">Kontak cepat</p>
        {kontakCepat.map((k) => (
          <a class="kontak-item" href={k.href} target="_blank" rel="noopener">
            <span class="kontak-item__label">{k.label}</span>
            <span class="kontak-item__value">{k.value}</span>
          </a>
        ))}
      </div>
 
      <div class="card form-card">
        <h3>Kirim pesan atau permohonan doa</h3>
        <p class="info-card__desc">
          Isi formnya, lalu tombol "Kirim pesan" akan membuka WhatsApp dengan
          pesanmu sudah terisi otomatis, tinggal ditekan kirim di sana.
        </p>
        <form class="kontak-form" id="kontak-form" data-wa-number={waNumber}>
          <label for="nama">Nama</label>
          <input id="nama" name="nama" type="text" required />
 
          <label for="email">Email atau nomor WhatsApp</label>
          <input id="email" name="email" type="text" required />
 
          <label for="pesan">Pesan</label>
          <textarea id="pesan" name="pesan" rows="4" required></textarea>
 
          <button class="btn btn-primary" type="submit">Kirim pesan</button>
        </form>
      </div>
    </div>
  </section>
</Base>
 
<script>
  const form = document.getElementById('kontak-form');
 
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
 
    const waNumber = form.getAttribute('data-wa-number') || '';
    const nama = (document.getElementById('nama') as HTMLInputElement).value.trim();
    const kontak = (document.getElementById('email') as HTMLInputElement).value.trim();
    const pesan = (document.getElementById('pesan') as HTMLTextAreaElement).value.trim();
 
    const teks = `Halo, saya ${nama} (${kontak}).\n\n${pesan}`;
    const url = `https://wa.me/${waNumber}?text=${encodeURIComponent(teks)}`;
 
    window.open(url, '_blank');
  });
</script>
 
<style>
  .page-header { padding: 64px 0 40px; }
  .page-header__lead {
    color: var(--ink-700);
    font-size: 1.05rem;
    max-width: 60ch;
  }
 
  .kontak-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 32px;
    align-items: start;
  }
 
  .kontak-item {
    display: flex;
    justify-content: space-between;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .kontak-item__label {
    color: var(--ink-500);
    font-size: 0.9rem;
  }
  .kontak-item__value {
    font-weight: 600;
  }
 
  .rekening-card { margin-top: 24px; }
 
  .form-card h3 { margin-bottom: 6px; }
 
  .kontak-form {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 20px;
  }
  .kontak-form label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-700);
    margin-top: 10px;
  }
  .kontak-form input,
  .kontak-form textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink-900);
    resize: vertical;
  }
  .kontak-form input:focus,
  .kontak-form textarea:focus {
    outline: none;
    border-color: var(--indigo-500);
  }
  .kontak-form button {
    margin-top: 16px;
    align-self: flex-start;
  }
 
  @media (max-width: 720px) {
    .kontak-grid { grid-template-columns: 1fr; }
  }
</style>