---
const jumlah = 60;
---
<div class="bendera" aria-hidden="true">
  <span class="bendera__tali"></span>
  <div class="bendera__deret">
    {Array.from({ length: jumlah }).map((_, i) => (
      <span
        class:list={['bendera__flag', i % 2 === 0 ? 'is-merah' : 'is-putih']}
        style={`--i:${i}`}
      ></span>
    ))}
  </div>
</div>

<style>
  .bendera {
    position: relative;
    width: 100%;
    height: 46px;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    background: var(--indigo-950);
    padding-top: 2px;
  }

  .bendera__tali {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    height: 2px;
    background: #ffffff;
    opacity: 1;
  }

  .bendera__deret {
    display: flex;
    gap: 6px;
    padding-left: 4px;
  }

  .bendera__flag {
    flex: 0 0 26px;
    height: 34px;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    transform-origin: 50% 0;
    animation: ayun 2.6s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.09s);
    filter: drop-shadow(0 2px 2px rgba(28, 36, 56, 0.18));
  }

  .bendera__flag.is-merah {
    background: linear-gradient(160deg, #e03131 0%, #c1121f 100%);
  }
  .bendera__flag.is-putih {
    background: linear-gradient(160deg, #ffffff 0%, #f2ede3 100%);
    filter: drop-shadow(0 0 0.6px rgba(28, 36, 56, 0.5)) drop-shadow(0 3px 3px rgba(28, 36, 56, 0.22));
  }

  @keyframes ayun {
    from { transform: rotate(-7deg); }
    to { transform: rotate(7deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bendera__flag { animation: none; }
  }

  @media (max-width: 640px) {
    .bendera { height: 36px; }
    .bendera__flag {
      flex: 0 0 20px;
      height: 26px;
    }
  }
</style>
