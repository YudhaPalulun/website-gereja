---
const navItems = [
  { href: '/', label: 'Beranda' },
  { href: '/tentang', label: 'Tentang' },
  { href: '/goc', label: 'GOC' },
  { href: '/berita', label: 'Berita' },
  { href: '/kontak', label: 'Kontak' },
];
const currentPath = Astro.url.pathname;

function isCurrent(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      <img src="/images/Sinode.png" alt="Logo GPT. Kristus Gembala Kupang" class="site-header__logo" />
      <span>GPT. Kristus Gembala Kupang</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
    <label for="nav-toggle" class="nav-toggle-btn" aria-label="Buka menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Navigasi utama">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="site-nav__link"
          aria-current={isCurrent(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--indigo-950);
    color: var(--paper);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--paper);
  }

  .site-header__logo {
  height: 42px;
  width: auto;
  display: block;
  flex-shrink: 0;
}

@media (max-width: 720px) {
  .site-header__logo { height: 30px; }
}

  .site-nav {
    display: flex;
    gap: 28px;
  }

  .site-nav__link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--paper);
    opacity: 0.82;
    padding: 6px 2px;
    border-bottom: 2px solid transparent;
  }

  .site-nav__link:hover { opacity: 1; }

  .site-nav__link[aria-current='page'] {
    opacity: 1;
    border-bottom-color: var(--marigold-500);
  }

  .nav-toggle-input,
  .nav-toggle-btn {
    display: none;
  }

  @media (max-width: 720px) {
    .nav-toggle-btn {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 32px;
      height: 32px;
      cursor: pointer;
    }
    .nav-toggle-btn span {
      display: block;
      height: 2px;
      background: var(--paper);
      border-radius: 2px;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--indigo-950);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .nav-toggle-input {
      display: block;
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .nav-toggle-input:focus-visible + .nav-toggle-btn {
      outline: 3px solid var(--marigold-500);
      outline-offset: 2px;
    }

    .nav-toggle-input:checked ~ .site-nav {
      max-height: 300px;
    }

    .site-nav__link {
      padding: 14px 24px;
      border-bottom: 1px solid rgba(251, 248, 241, 0.12);
    }
  }
</style>
