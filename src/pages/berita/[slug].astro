---
import Base from '../../layouts/Base.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const berita = await getCollection('berita');
  return berita.map((b) => ({
    params: { slug: b.id },
    props: { b },
  }));
}

const { b } = Astro.props as { b: CollectionEntry<'berita'> };
const { Content } = await render(b);

function formatTanggal(date: Date) {
  return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
}
---
<Base title={b.data.judul} description={b.data.ringkasan}>
  <article class="section">
    <div class="container narrow">
      <a class="back-link" href="/berita">&larr; Kembali ke semua berita</a>
      <p class="eyebrow">{formatTanggal(b.data.tanggal)}</p>
      <h1>{b.data.judul}</h1>
      <img src={b.data.gambarDetail ?? b.data.gambar} alt={b.data.judul} class="artikel__img" />
      <Content />
    </div>
  </article>
</Base>

<style>
  .narrow {
    max-width: 720px;
  }
  .back-link {
    display: inline-block;
    color: var(--ink-500);
    font-size: 0.9rem;
    margin-bottom: 24px;
  }
  .back-link:hover { color: var(--indigo-950); }
  .artikel__img {
    width: 100%;
    max-height: 360px;
    object-fit: cover;
    border-radius: var(--radius);
    margin: 20px 0 28px;
  }
</style>
