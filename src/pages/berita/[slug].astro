---
import Base from '../../layouts/Base.astro';
import { berita } from '../../data/berita';

export function getStaticPaths() {
  return berita.map((b) => ({
    params: { slug: b.slug },
    props: { b },
  }));
}

const { b } = Astro.props as { b: (typeof berita)[number] };
---
<Base title={b.judul} description={b.ringkasan}>
  <article class="section">
    <div class="container narrow">
      <a class="back-link" href="/berita">&larr; Kembali ke semua berita</a>
      <p class="eyebrow">{b.tanggal}</p>
      <h1>{b.judul}</h1>
      <img src={b.gambar} alt={b.judul} class="artikel__img" />
      {b.isi.map((paragraf) => (
        <p>{paragraf}</p>
      ))}
    </div>
  </article>
</Base>

<style>
  .narrow {
    max-width: 720px;
  }
  .back-link {
    display: inline-block;
    color: var(--ink-500);
    font-size: 0.9rem;
    margin-bottom: 24px;
  }
  .back-link:hover { color: var(--indigo-950); }
  .artikel__img {
    width: 100%;
    max-height: 360px;
    object-fit: cover;
    border-radius: var(--radius);
    margin: 20px 0 28px;
  }
</style>