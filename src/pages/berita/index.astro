---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const berita = (await getCollection('berita')).sort(
  (a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf()
);

function formatTanggal(date: Date) {
  return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
}
---
<Base title="Berita" description="GPT UPDATE!.">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Berita</p>
      <h1 class="neon">GPT UPDATE!</h1>
      <p class="page-header__lead">
        Kumpulan berita dan kegiatan terbaru dari jemaat kami.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container berita-grid">
      {berita.map((b) => (
        <a class="card berita-card" href={`/berita/${b.id}`}>
          <img src={b.data.gambar} alt={b.data.judul} class="berita-card__img" loading="lazy" />
          <div class="berita-card__body">
            <p class="berita-card__tanggal">{formatTanggal(b.data.tanggal)}</p>
            <h3>{b.data.judul}</h3>
            <p class="info-card__desc">{b.data.ringkasan}</p>
            <span class="info-card__cta">Baca selengkapnya &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .page-header { padding: 64px 0 40px; }
  .page-header__lead {
    color: var(--ink-700);
    font-size: 1.05rem;
    max-width: 60ch;
  }

  .berita-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .berita-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .berita-card__img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }
  .berita-card__body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }
  .berita-card__tanggal {
    color: var(--marigold-700);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin: 0;
  }
  .berita-card h3 { margin: 0; }
  .berita-card .info-card__desc { flex-grow: 1; }

  @media (max-width: 900px) {
    .berita-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .berita-grid { grid-template-columns: 1fr; }
  }
  .neon {
    --neon-warna: #ff2d2d;
    color: #fff;
    text-shadow:
      0 0 4px #fff,
      0 0 10px var(--neon-warna),
      0 0 22px var(--neon-warna),
      0 0 40px var(--neon-warna);
    animation:
      neon-warna 3s steps(1) infinite,
      neon-kedip 4.5s ease-in-out infinite;
  }

  @keyframes neon-warna {
    0%, 49% { --neon-warna: #ff2d2d; }
    50%, 100% { --neon-warna: #7aa2ff; }
  }

  @keyframes neon-kedip {
    0%, 8%, 10%, 14%, 100% { opacity: 1; }
    9% { opacity: 0.35; }
    12% { opacity: 0.5; }
    62% { opacity: 1; }
    63% { opacity: 0.3; }
    64% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .neon { animation: none; }
  }
</style>
