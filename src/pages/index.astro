---
import Base from '../layouts/Base.astro';
import WovenDivider from '../components/WovenDivider.astro';
import HeroSlider from '../components/HeroSlider.astro';
import Marquee from '../components/Marquee.astro';
import { berita } from '../data/berita';
 
const beritaTerbaru = berita.slice(0, 3);
 
const slides = [
  {
    image: '/images/hero/slide-1.jpeg',
    alt: 'Jemaat berkumpul dalam ibadah minggu',
    kicker: '',
    title: '',
    excerpt: '',
    ctaLabel: 'Lihat jadwal lengkap',
    ctaHref: '/ibadah',
  },
  {
    image: '/images/hero/slide-2.jpeg',
    alt: 'Kegiatan persekutuan dan pelayanan jemaat',
    kicker: 'Bertumbuh bersama',
    title: 'Ada tempat untuk setiap usia',
    excerpt: 'Dari sekolah minggu sampai persekutuan lansia — temukan komunitas yang cocok untukmu.',
    ctaLabel: 'Kenal lebih dekat',
    ctaHref: '/tentang',
  },
  {
    image: '/images/hero/slide-3.jpeg',
    alt: 'Menyambut jemaat baru',
    kicker: 'Jemaat baru?',
    title: 'Kami senang menyambutmu',
    excerpt: 'Baru pertama kali datang? Tidak ada aturan berpakaian khusus — datang saja apa adanya.',
    ctaLabel: 'Info kunjungan pertama',
    ctaHref: '/ibadah',
  },
];
 
const jadwalCarousel = [
  { title: 'Doa Penyembahan', hari: 'Selasa', jam: '18.00 WITA', image: '/images/jadwal/jadwal-1.jpg' },
  { title: 'Ibadah Pendalaman Alkitab', hari: 'Jumat', jam: '18.00 WITA', image: '/images/jadwal/jadwal-2.jpg' },
  { title: 'Doa Puasa', hari: 'Sabtu', jam: '11.00 WITA', image: '/images/jadwal/jadwal-3.jpg' },
  { title: 'Ibadah Raya Minggu', hari: 'Minggu', jam: '09.00 WITA', image: '/images/jadwal/jadwal-4.jpg' },
  { title: 'Ibadah Sekolah Minggu', hari: 'Minggu', jam: '09.30 WITA', image: '/images/jadwal/jadwal-5.jpg' },
];
 
const bottomCards = [
  {
    title: 'Lokasi',
    desc: 'Jl. W. J Lalamentik No. 59a, Oebobo No.',
    href: 'https://www.google.com/maps/place/GPT.+Kristus+Gembala/@-10.1672772,123.6021265,17z/data=!3m1!4b1!4m6!3m5!1s0x2c569cabc609361d:0x62e9587578e5e97a!8m2!3d-10.1672772!4d123.6047014!16s%2Fg%2F11c0t9s83g',
    cta: 'Lihat peta & arah',
    icon: 'pin',
    mapEmbed: 'https://www.google.com/maps?q=-10.1672772,123.6047014&z=17&output=embed',
  },
  {
    title: 'Butuh konseling?',
    desc: 'Untuk permohonan doa, konseling, atau pertanyaan lain, tim kami siap membantu.',
    href: '/kontak',
    cta: 'Hubungi kami',
    icon: 'chat',
  },
];
 
function infoIconPath(name: string) {
  switch (name) {
    case 'calendar':
      return '<rect x="3" y="5" width="18" height="16" rx="2" fill="none"/><path d="M3 9h18" fill="none"/><path d="M8 3v4" fill="none"/><path d="M16 3v4" fill="none"/>';
    case 'pin':
      return '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" fill="none"/><circle cx="12" cy="10" r="2.4" fill="none"/>';
    case 'door':
      return '<path d="M5 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16" fill="none"/><path d="M4 21h16" fill="none"/><circle cx="12.5" cy="12" r="1" fill="none"/>';
    case 'chat':
      return '<path d="M4 5h16v11H9l-5 4z" fill="none"/>';
    default:
      return '';
  }
}
 
const visiMisi = [
  {
    label: 'Visi',
    isi: 'Menjadi Gereja yang menuju kepada kesempurnaan untuk bertemu dengan Kristus Mempelai Pria Sorga.',
  },
  {
    label: 'Misi',
    isi: 'Memberitakan Injil, menasihati dan mengajarkan dengan segala hikmat kepada setiap orang yang dipanggil datang kepada Kristus.',
  },
];
---
<Base title="Beranda">
  <HeroSlider slides={slides} />
  <Marquee text="GPT RUMAH KITA " />
 
  <WovenDivider />
 
  <!-- Jadwal ibadah -->
  <section class="section">
    <div class="container jadwal-section">
      <div class="jadwal-heading">
        <div>
          <p class="eyebrow">Minggu ini</p>
          <h2>Jadwal ibadah</h2>
        </div>
        <div class="jadwal-arrows">
          <button class="jadwal-arrow jadwal-arrow--prev" type="button" aria-label="Jadwal sebelumnya">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <button class="jadwal-arrow jadwal-arrow--next" type="button" aria-label="Jadwal berikutnya">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
 
      <div class="jadwal-carousel">
        <div class="jadwal-carousel__viewport">
          <div class="jadwal-carousel__track">
            {jadwalCarousel.map((item) => (
              <a class="jadwal-card" href={item.image}>
                <img src={item.image} alt={item.title} class="jadwal-card__img" loading="lazy" />
                <div class="jadwal-card__badge">
                  <span>{item.hari}</span>
                  <span>{item.jam}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
 
  <WovenDivider />
 
  <!-- Definisi Gereja -->
  <section class="definisi">
    <div class="definisi__content">
      <h2 class="definisi__title">GPT. Kristus Gembala Kupang</h2>
      <p class="definisi__text">
        GPT. Kristus Gembala Kupang adalah gereja yang sedang dibentuk menuju kesempurnaan,
        mempersiapkan diri untuk bertemu dengan Kristus sebagai Mempelai Pria Sorga.
        Kami percaya bahwa hidup bergereja adalah perjalanan penyucian yang terus-menerus,
        sampai kita layak dan siap menyambut kedatangan-Nya.
      </p>
      <p class="definisi__text">
        Kami terpanggil untuk memberitakan Injil kepada setiap orang,
        menasihati dan mengajarkan dengan segala hikmat kepada setiap orang
        yang dipanggil datang kepada Kristus — bukan sekadar berkumpul,
        tetapi bertumbuh bersama menuju kedewasaan penuh di dalam Kristus.
      </p>
    </div>
  </section>
 
  <WovenDivider />
 
 <!-- Visi & Misi -->
  <section class="section">
    <div class="container">
      <div class="visimisi-grid">
        {visiMisi.map((v) => (
          <div class="visimisi-item">
            <h3 class="visimisi-item__label">{v.label}</h3>
            <p class="visimisi-item__text">{v.isi}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <WovenDivider />
 
  <!-- Berita terbaru -->
  <section class="section">
    <div class="container">
      <div class="berita-heading">
        <div>
          <p class="eyebrow">Kabar gereja</p>
          <h2>Berita terbaru</h2>
        </div>
        <a class="btn btn-ghost" href="/berita">Lihat semua berita</a>
      </div>
      <div class="berita-grid-home">
        {beritaTerbaru.map((b) => (
          <a class="card berita-card" href={`/berita/${b.slug}`}>
            <div class="berita-card__img-wrap">
              <img src={b.gambar} alt={b.judul} class="berita-card__img" loading="lazy" />
            </div>
            <div class="berita-card__body">
              <p class="berita-card__tanggal">{b.tanggal}</p>
              <h3>{b.judul}</h3>
              <p class="info-card__desc">{b.ringkasan}</p>
              <span class="info-card__cta">Baca selengkapnya &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
 
  <WovenDivider />
 
  <!-- Lokasi & kontak -->
  <section class="section">
    <div class="container bottom-cards">
      {bottomCards.map((card) => (
        <div class="card info-card">
          <div class="info-card__icon">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={infoIconPath(card.icon)} />
          </div>
          <h3>{card.title}</h3>
          <p class="info-card__desc">{card.desc}</p>
          {card.mapEmbed && (
            <div class="info-card__map">
              <iframe
                src={card.mapEmbed}
                title={`Peta lokasi ${card.title}`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          )}
          <a class="info-card__cta" href={card.href} target={card.mapEmbed ? '_blank' : undefined} rel={card.mapEmbed ? 'noopener' : undefined}>{card.cta} &rarr;</a>
        </div>
      ))}
    </div>
  </section>
</Base>
 
<style>
  .jadwal-section {
    max-width: 1320px;
  }
 
  .jadwal-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }
  .jadwal-heading h2 { margin: 0; }
 
  .jadwal-arrows {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }
  .jadwal-arrow {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: transparent;
    border: 1.5px solid var(--line);
    color: var(--indigo-950);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .jadwal-arrow:hover {
    background: var(--indigo-950);
    border-color: var(--indigo-950);
    color: var(--paper);
  }
  .jadwal-arrow svg { width: 18px; height: 18px; }
 
  .jadwal-carousel__viewport {
    overflow: hidden;
  }
  .jadwal-carousel__track {
    display: flex;
    gap: 20px;
    transition: transform 0.35s ease;
  }
 
  .jadwal-card {
    flex: 0 0 calc((100% - 40px) / 3);
    display: block;
    border-radius: 12px;
    overflow: hidden;
    background: var(--paper-dim);
    border: 1px solid var(--line);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .jadwal-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 22px rgba(28, 36, 56, 0.14);
    border-color: var(--indigo-500);
  }
  .jadwal-card__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .jadwal-card__badge {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    background: var(--marigold-600);
    color: var(--paper);
    font-size: 0.74rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 999px;
    margin: 12px;
  }
 
  @media (max-width: 900px) {
    .jadwal-card { flex: 0 0 calc((100% - 20px) / 2); }
  }
  @media (max-width: 640px) {
    .jadwal-card { flex: 0 0 100%; }
  }
 
  .bottom-cards {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 680px;
    margin: 0 auto;
  }
  .info-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .info-card:hover {
    border-color: var(--indigo-500);
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(28, 36, 56, 0.12);
  }
  .info-card h3 {
    font-size: 1.3rem;
  }
  .info-card__icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--indigo-950);
    color: var(--marigold-500);
    display: flex;

  .info-card__icon svg {
    width: 26px;
    height: 26px;
  }
  }
  .info-card__desc {
    color: var(--ink-700);
    font-size: 0.92rem;
    margin: 0;
    flex-grow: 1;
  }
  .info-card__map {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .info-card__map iframe {
    width: 100%;
    height: 200px;
    border: 0;
    display: block;
  }
  .info-card__cta {
    display: inline-block;
    color: var(--marigold-700);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }
 
  .definisi {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 520px;
    padding: 80px 24px;
    background-image: url('/images/definisi/foto-bersama-bw.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
  }
  .definisi::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(28, 36, 56, 0.74);
  }
  .definisi__content {
    position: relative;
    z-index: 1;
    max-width: 860px;
    text-align: center;
  }
  .definisi__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    color: var(--paper);
    margin-bottom: 44px;
  }
  .definisi__text {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.92rem;
    line-height: 1.9;
    color: rgba(251, 248, 241, 0.88);
    margin: 0 0 32px;
  }
  .definisi__text:last-child {
    margin-bottom: 0;
  }
 
  .visimisi-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-top: 48px;
  }
  .visimisi-grid::before {
    content: '';
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 50%;
    width: 1px;
    background: var(--line);
  }
  .visimisi-item__label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 4.5vw, 3.2rem);
    color: var(--indigo-950);
    margin: 0 0 14px;
  }
  .visimisi-item__text {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--marigold-700);
    max-width: 42ch;
    margin: 0;
  }
 
  @media (max-width: 900px) {
    .berita-grid-home { grid-template-columns: repeat(2, 1fr) !important; }
  }
  @media (max-width: 640px) {
    .berita-grid-home { grid-template-columns: 1fr !important; }
    .berita-heading { flex-direction: column; align-items: flex-start !important; gap: 16px; }
    .definisi { padding: 56px 20px; min-height: auto; }
    .visimisi-grid { grid-template-columns: 1fr; gap: 28px; }
    .visimisi-grid::before { display: none; }
    .visimisi-item:not(:first-child) {
      padding-top: 28px;
      border-top: 1px solid var(--line);
    }
  }
 
  .berita-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
    gap: 16px;
  }
  .berita-heading h2 { margin: 0; }
 
  .berita-grid-home {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .berita-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .berita-card__img-wrap {
    position: relative;
    overflow: hidden;
  }
  .berita-card__img-wrap::after {
    content: '';
    position: absolute;
    top: 0;
    left: -150%;
    width: 55%;
    height: 100%;
    background: linear-gradient(
      115deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.45) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    animation: berita-shine 2s ease-in-out infinite;
  }
  @keyframes berita-shine {
    0% { left: -150%; }
    100% { left: 150%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .berita-card__img-wrap::after { animation: none; }
  }
  .berita-card__img {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }
  .berita-card__body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-grow: 1;
  }
  .berita-card__tanggal {
    color: var(--marigold-700);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin: 0;
  }
  .berita-card h3 { margin: 0; font-size: 1.3rem; }
  .berita-card .info-card__desc { flex-grow: 1; }
</style>
 
<script>
  function initJadwalCarousel(section: Element) {
    const viewportEl = section.querySelector<HTMLElement>('.jadwal-carousel__viewport');
    const trackEl = section.querySelector<HTMLElement>('.jadwal-carousel__track');
    const prevBtn = section.querySelector<HTMLElement>('.jadwal-arrow--prev');
    const nextBtn = section.querySelector<HTMLElement>('.jadwal-arrow--next');
    const cards = Array.from(section.querySelectorAll<HTMLElement>('.jadwal-card'));
    if (!viewportEl || !trackEl || cards.length === 0) return;
 
    const viewport: HTMLElement = viewportEl;
    const track: HTMLElement = trackEl;
    let index = 0;
 
    function getStep() {
      const cardWidth = cards[0].getBoundingClientRect().width;
      const styles = getComputedStyle(track);
      const rawGap = styles.columnGap || styles.gap || '20';
      const gap = parseFloat(rawGap);
      return cardWidth + (Number.isFinite(gap) ? gap : 20);
    }
 
    function getVisibleCount() {
      const step = getStep();
      return Math.max(1, Math.round(viewport.getBoundingClientRect().width / step));
    }
 
    function getMaxIndex() {
      return Math.max(0, cards.length - getVisibleCount());
    }
 
    function render() {
      const step = getStep();
      track.style.transform = `translateX(-${index * step}px)`;
    }
 
    function next() {
      const maxIndex = getMaxIndex();
      index = index >= maxIndex ? 0 : index + 1;
      render();
    }
 
    function prev() {
      const maxIndex = getMaxIndex();
      index = index <= 0 ? maxIndex : index - 1;
      render();
    }
 
    nextBtn?.addEventListener('click', next);
    prevBtn?.addEventListener('click', prev);
    window.addEventListener('resize', () => {
      index = Math.min(index, getMaxIndex());
      render();
    });
 
    render();
  }
 
  document.querySelectorAll('.jadwal-section').forEach(initJadwalCarousel);
</script>