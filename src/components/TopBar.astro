---
interface Item {
  icon: 'facebook' | 'phone' | 'pin';
  label: string;
  href: string;
}

const items: Item[] = [
  { icon: 'facebook', label: 'Yeremia Priyanto  ||', href: 'https://facebook.com/YeremiaPriyanto' },
  { icon: 'phone', label: '+62811-3822-774  ||', href: 'tel:+62811-3822-774' },
  { icon: 'pin', label: 'Jl. W.J Lalamentik. No. 59a', href: '/ibadah#lokasi' },
];

function iconPath(name: Item['icon']) {
  switch (name) {
    case 'facebook':
      return '<path d="M15 3h-3a4 4 0 0 0-4 4v3H5v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h3z" fill="none"/>';
    case 'phone':
      return '<path d="M5 4h3l1.5 4L8 9.5a12 12 0 0 0 6.5 6.5L16 14.5l4 1.5v3a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4z" fill="none"/>';
    case 'pin':
      return '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" fill="none"/><circle cx="12" cy="10" r="2.4" fill="none"/>';
    default:
      return '';
  }
}
---
<div class="topbar">
  <div class="container topbar__inner">
    {items.map((item) => (
      <a class="topbar__item" href={item.href}>
        <svg class="topbar__icon" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPath(item.icon)} />
        <span class="topbar__label">{item.label}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .topbar {
    background: var(--paper-dim);
    border-bottom: 1px solid var(--line);
    font-size: 0.84rem;
  }

  .topbar__inner {
    display: flex;
    justify-content: center;
    gap: 28px;
    padding: 9px 24px;
  }

  .topbar__item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-700);
    white-space: nowrap;
  }
  .topbar__item:hover { color: var(--indigo-950); }

  .topbar__icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .topbar__item:nth-child(3) { display: none; }
  }

  @media (max-width: 420px) {
    .topbar__label { display: none; }
    .topbar__inner { gap: 20px; }
  }
</style>
